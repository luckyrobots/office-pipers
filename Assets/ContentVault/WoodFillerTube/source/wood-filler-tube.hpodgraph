  height_m:
    kind: Float
    default: 0.193000004
    desc: Measured overall height, metres. Upright local Y axis; origin at geometric mid-height.
    group: Measured dimensions / estimated dynamics
    min: 0.100000001
    max: 0.349999994
  diameter_m:
    kind: Float
    default: 0.0430000015
    desc: Measured widest body diameter, metres.
    group: Measured dimensions / estimated dynamics
    min: 0.0199999996
    max: 0.0799999982
  mass_kg:
    kind: Float
    default: 0.180000007
    desc: "ESTIMATE: rigid approximation total mass, kg. Weigh the physical tube before dynamics qualification."
    group: Measured dimensions / estimated dynamics
    min: 0.0299999993
    max: 0.5
  sliding_friction:
    kind: Float
    default: 0.699999988
    desc: "ESTIMATE: MuJoCo sliding friction; not experimentally identified."
    group: Measured dimensions / estimated dynamics
