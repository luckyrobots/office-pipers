parameters:
  visible:
    kind: Bool
    default: true
    desc: Show the guides. HideOnPlay on Measurements turns this off while playing.
    group: Plate holder
  holder_x:
    kind: Float
    default: 0.207106
    desc: "Plate holder centre X in metres, from the desk centre. Copy it from OSTBIT_Plate_Holder's position."
    group: Plate holder
  holder_z:
    kind: Float
    default: 0.0
    desc: "Plate holder centre Z in metres, from the desk centre. Negative is towards the back edge."
    group: Plate holder
  holder_width:
    kind: Float
    default: 0.120292
    desc: "Plate holder footprint along X, in metres."
    group: Plate holder
  holder_depth:
    kind: Float
    default: 0.28068
    desc: "Plate holder footprint along Z, in metres."
    group: Plate holder
  desk_width:
    kind: Float
    default: 1.4
    desc: "Desk top along X, in metres."
    group: Plate holder
  desk_depth:
    kind: Float
    default: 0.7
    desc: "Desk top along Z, in metres."
    group: Plate holder
  desk_top:
    kind: Float
    default: 0.75
    desc: "Height of the desk top, in metres."
    group: Plate holder
outputs:
  Geometry:
    node: 133
    pin: Geometry
