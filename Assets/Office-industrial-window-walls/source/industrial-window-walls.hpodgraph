parameters:
  show_left_wall:
    kind: Bool
    default: true
    desc: "Show the left side wall (x -8.83) and its industrial window. Place this entity at the scene origin."
    group: Walls
  show_right_wall:
    kind: Bool
    default: true
    desc: "Show the right side wall (x 9.54) and its industrial window. Place this entity at the scene origin."
    group: Walls
  show_roof:
    kind: Bool
    default: true
    desc: "Show the warehouse roof: steel trusses from wall to wall, purlins, a metal deck and an open skylight strip."
    group: Walls
outputs:
  Geometry:
    node: 492
    pin: Geometry
