ode: 999, pin: Geometry}, to: {node: 1019, pin: B}}]
parameters:
  show_laptop_speakers_cables:
    kind: Bool
    default: true
    desc: Show the laptop, both studio speakers and the cables from them to the subwoofer. Turn off for a clear desk.
    group: Desk items
  laptop_position:
    kind: Float3
    default:
    - -1.15054
    - 0.9987
    - -1.055
    desc: "Laptop position, the middle of the laptop with its base on the desk, in metres from the Computer station's origin: X along the desk, Y up, Z towards the wall is negative."
    group: Desk items
  speaker_1_position:
    kind: Float3
    default:
    - -1.65
    - 0.895
    - -1.22
    desc: "Speaker 1 (left) position, the bottom middle of its cabinet, in metres from the Computer station's origin: X along the desk, Y up, Z towards the wall is negative."
    group: Desk items
  speaker_2_position:
    kind: Float3
    default:
    - -0.55
    - 0.895
    - -1.22
    desc: "Speaker 2 (right) position, the bottom middle of its cabinet, in metres from the Computer station's origin: X along the desk, Y up, Z towards the wall is negative."
    group: Desk items
outputs:
  Geometry:
    node: 1026
    pin: Geometry
