parameters:
  show_laptop_speakers_cables:
    kind: Bool
    default: true
    desc: Show the laptop, both studio speakers and their cables. Turn off for a clear desk.
    group: Desk items
  laptop_position:
    kind: Float3
    default:
    - -1.15054
    - 1.00174
    - -0.770614
    desc: "Laptop position, in metres from the Computer station's origin: X along the desk, Y up, Z towards the wall is negative."
    group: Desk items
  speaker_1_position:
    kind: Float3
    default:
    - -1.6643
    - 1.03524
    - -1.2464
    desc: "Speaker 1 (left) position, in metres from the Computer station's origin: X along the desk, Y up, Z towards the wall is negative."
    group: Desk items
  speaker_2_position:
    kind: Float3
    default:
    - -0.539725
    - 1.03524
    - -1.2464
    desc: "Speaker 2 (right) position, in metres from the Computer station's origin: X along the desk, Y up, Z towards the wall is negative."
    group: Desk items
outputs:
  Geometry:
    node: 1026
    pin: Geometry
