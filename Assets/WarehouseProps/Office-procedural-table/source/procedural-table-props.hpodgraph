  - {id: 12, type: Transform, name: "Prop 1 placement", x: 340, y: 2310}
  - {id: 13, type: Compare, name: "act0 Greater 0.5", inputs: {A: {param: act0}, B: {kind: Float, value: 0.5}, Operation: {kind: Menu, value: Greater}}, x: 40, y: 850}
