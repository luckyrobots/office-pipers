parameters:
  seed: {kind: Int32, default: 7, group: "Table match", min: 0, max: 1000000, desc: "Table seed. Use the SAME value as the procedural table so the top size matches."}
  table_type: {kind: Int32, default: 0, group: "Table match", options: ["Random (from seed)", "Four-leg table", "Trestle table", "Pedestal table", "Bench", "Bench with drawers"], desc: "Same as the table's table_type."}
  shuffle_type: {kind: Int32, default: 0, group: "Table match", min: 0, max: 1000, desc: "Same as the table's shuffle_type."}
  shuffle_dimensions: {kind: Int32, default: 0, group: "Table match", min: 0, max: 1000, desc: "Same as the table's shuffle_dimensions."}
  prop_seed: {kind: Int32, default: 1, group: "Props", min: 0, max: 1000000, desc: "Re-rolls where the props go and how they are turned."}
  prop_count: {kind: Int32, default: 6, group: "Props", min: 1, max: 10, desc: "How many props to place (1 to 10)."}
  edge_margin: {kind: Float, default: 0.07, group: "Props", min: 0, max: 0.3, desc: "Keep props this far from the table edge (metres)."}
  drop_height: {kind: Float, default: 0.12, group: "Props", min: 0, max: 0.5, desc: "Height above the table top where props start; physics drops them."}
  tumble: {kind: Float, default: 0, group: "Props", min: 0, max: 1, desc: "0 keeps props upright with only a random turn; 1 gives fully random orientations."}
  ts: {kind: Float, expr: "seed + shuffle_type*7919"}
  ds: {kind: Float, expr: "seed + shuffle_dimensions*7919"}
  r_type: {kind: Float, expr: "sin(ts*12.9898+78.233)*43758.5453 - floor(sin(ts*12.9898+78.233)*43758.5453)"}
  type_i: {kind: Float, expr: "min(1,table_type)*(table_type-1) + (1-min(1,table_type))*floor(r_type*5)"}
  is0: {kind: Float, expr: "max(0, 1 - abs(type_i - 0))"}
  is1: {kind: Float, expr: "max(0, 1 - abs(type_i - 1))"}
  is2: {kind: Float, expr: "max(0, 1 - abs(type_i - 2))"}
  is3: {kind: Float, expr: "max(0, 1 - abs(type_i - 3))"}
  is4: {kind: Float, expr: "max(0, 1 - abs(type_i - 4))"}
  r_pedround: {kind: Float, expr: "sin(ts*12.9898+625.864)*43758.5453 - floor(sin(ts*12.9898+625.864)*43758.5453)"}
  r_w: {kind: Float, expr: "sin(ds*12.9898+1329.96)*43758.5453 - floor(sin(ds*12.9898+1329.96)*43758.5453)"}
  r_d: {kind: Float, expr: "sin(ds*12.9898+1408.19)*43758.5453 - floor(sin(ds*12.9898+1408.19)*43758.5453)"}
  r_h: {kind: Float, expr: "sin(ds*12.9898+1486.43)*43758.5453 - floor(sin(ds*12.9898+1486.43)*43758.5453)"}
  r_topt: {kind: Float, expr: "sin(ds*12.9898+1564.66)*43758.5453 - floor(sin(ds*12.9898+1564.66)*43758.5453)"}
  r_bev: {kind: Float, expr: "sin(ds*12.9898+1642.89)*43758.5453 - floor(sin(ds*12.9898+1642.89)*43758.5453)"}
  W: {kind: Float, expr: "(is0*0.9 + is1*1.4 + is2*0.7 + is3*1.2 + is4*1) + r_w*(is0*1.1 + is1*1 + is2*0.6 + is3*1 + is4*1)"}
  D_raw: {kind: Float, expr: "(is0*0.55 + is1*0.65 + is2*0.7 + is3*0.55 + is4*0.5) + r_d*(is0*0.45 + is1*0.3 + is2*0.6 + is3*0.25 + is4*0.25)"}
  D: {kind: Float, expr: "is2*W + (1-is2)*D_raw"}
  H: {kind: Float, expr: "(is0*0.7 + is1*0.72 + is2*0.7 + is3*0.8 + is4*0.8) + r_h*(is0*0.08 + is1*0.06 + is2*0.06 + is3*0.15 + is4*0.12)"}
  top_t: {kind: Float, expr: "(is0*0.02 + is1*0.03 + is2*0.025 + is3*0.04 + is4*0.03) + r_topt*(is0*0.03 + is1*0.03 + is2*0.025 + is3*0.05 + is4*0.03)"}
  top_y: {kind: Float, expr: "H - top_t/2"}
  top_r: {kind: Float, expr: "W/2"}
  ped_round: {kind: Float, expr: "floor(r_pedround + 0.65)"}
  top_round: {kind: Float, expr: "is2*ped_round"}
  hx: {kind: Float, expr: "max(0.02, (1-top_round)*(W/2-edge_margin) + top_round*(top_r*0.7071-edge_margin))"}
  hz: {kind: Float, expr: "max(0.02, (1-top_round)*(D/2-edge_margin) + top_round*(top_r*0.7071-edge_margin))"}
  cols: {kind: Float, expr: "min(prop_count, max(1, floor(sqrt(prop_count*hx/hz) + 0.5)))"}
  rows: {kind: Float, expr: "ceil(prop_count/cols)"}
  cells: {kind: Float, expr: "cols*rows"}
  cw: {kind: Float, expr: "2*hx/cols"}
  ch_: {kind: Float, expr: "2*hz/rows"}
  r_celloff: {kind: Float, expr: "sin(prop_seed*12.9898+1721.13)*43758.5453 - floor(sin(prop_seed*12.9898+1721.13)*43758.5453)"}
  r_propbase: {kind: Float, expr: "sin(prop_seed*12.9898+1799.36)*43758.5453 - floor(sin(prop_seed*12.9898+1799.36)*43758.5453)"}
  cell_off: {kind: Float, expr: "floor(r_celloff*cells)"}
  prop_base: {kind: Float, expr: "floor(r_propbase*10)"}
  surf_y: {kind: Float, expr: "H + drop_height"}
  act0: {kind: Float, expr: "min(1, max(0, prop_count - 0))"}
