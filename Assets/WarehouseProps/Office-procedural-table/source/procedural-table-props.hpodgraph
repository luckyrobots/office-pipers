# Procedural table. Change `seed` for a different table (type, size, finish, details).
# table_type forces a type; shuffle_type / shuffle_dimensions / shuffle_materials re-roll one aspect only.
# bevel / bevel_variation / bevel_segments control the rounded edges on every part.
# All randomness is derived from `seed` by the derived (expr) parameters at the end of this file.
nodes:
  - {id: 1, type: MeshCube, name: "Table top", inputs: {SizeX: {param: W}, SizeY: {param: top_t}, SizeZ: {param: D}}, x: 40, y: 40}
  - {id: 2, type: CombineXYZ, name: "Table top position translation", inputs: {X: {kind: Float, value: 0}, Y: {param: top_y}, Z: {kind: Float, value: 0}}, x: 40, y: 170}
  - {id: 3, type: Transform, name: "Table top position", x: 340, y: 40}
  - {id: 4, type: MeshCylinder, name: "Table top round", inputs: {Sides: {kind: Int32, value: 64}, Radius: {param: top_r}, Height: {param: top_t}}, x: 40, y: 300}
  - {id: 5, type: CombineXYZ, name: "Table top round position translation", inputs: {X: {kind: Float, value: 0}, Y: {param: top_y}, Z: {kind: Float, value: 0}}, x: 40, y: 430}
  - {id: 6, type: Transform, name: "Table top round position", x: 340, y: 170}
  - {id: 7, type: Compare, name: "top_round Greater 0.5", inputs: {A: {param: top_round}, B: {kind: Float, value: 0.5}, Operation: {kind: Menu, value: Greater}}, x: 40, y: 720}
  - {id: 8, type: Switch, name: "Round top?", x: 640, y: 40}
  - {id: 9, type: MeshCube, name: "Prop 1 marker", inputs: {SizeX: {kind: Float, value: 0.14}, SizeY: {kind: Float, value: 0.02}, SizeZ: {kind: Float, value: 0.06}}, x: 40, y: 2310}
