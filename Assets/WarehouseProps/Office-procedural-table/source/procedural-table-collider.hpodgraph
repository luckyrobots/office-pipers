  sz5: {kind: Float, expr: "ring_r*sin(1.570796)"}
  sa5: {kind: Float, expr: "0.000000"}
  sx6: {kind: Float, expr: "ring_r*cos(1.884956)"}
  sz6: {kind: Float, expr: "ring_r*sin(1.884956)"}
