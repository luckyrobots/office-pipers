parameters:
  seed: {kind: Int32, default: 7, group: "Random", min: 0, max: 1000000, desc: "Master random seed (0 to 1,000,000). Each seed gives a different table: type, size, finish and details."}
  table_type: {kind: Int32, default: 0, group: "Random", options: ["Random (from seed)", "Four-leg table", "Trestle table", "Pedestal table", "Bench", "Bench with drawers"], desc: "Pick a type, or leave on Random to let the seed decide."}
  shuffle_type: {kind: Int32, default: 0, group: "Random", min: 0, max: 1000, desc: "Change this number to re-roll only the table type and its structure (leg shape, aprons, shelves, drawer layout)."}
  shuffle_dimensions: {kind: Int32, default: 0, group: "Random", min: 0, max: 1000, desc: "Change this number to re-roll only the dimensions (width, depth, height, thicknesses)."}
  shuffle_materials: {kind: Int32, default: 0, group: "Random", min: 0, max: 1000, desc: "Change this number to re-roll only the materials and finishes."}
  bevel: {kind: Float, default: 0.006, group: "Edges", min: 0, max: 0.03, desc: "Edge bevel width in metres. Clamped on thin parts. 0 gives sharp edges."}
  bevel_variation: {kind: Float, default: 0.5, group: "Edges", min: 0, max: 1, desc: "How much the seed varies the bevel width: 0 is always exactly 'bevel', 1 ranges from none to double."}
  bevel_segments: {kind: Int32, default: 3, group: "Edges", min: 1, max: 6, desc: "Segments per bevel: 1 is a flat chamfer, more is a rounder edge."}
  ts: {kind: Float, expr: "seed + shuffle_type*7919"}
  ds: {kind: Float, expr: "seed + shuffle_dimensions*7919"}
  ms: {kind: Float, expr: "seed + shuffle_materials*7919"}
  r_type: {kind: Float, expr: "sin(ts*12.9898+78.233)*43758.5453 - floor(sin(ts*12.9898+78.233)*43758.5453)"}
  type_i: {kind: Float, expr: "min(1,table_type)*(table_type-1) + (1-min(1,table_type))*floor(r_type*5)"}
  is0: {kind: Float, expr: "max(0, 1 - abs(type_i - 0))"}
  is1: {kind: Float, expr: "max(0, 1 - abs(type_i - 1))"}
  is2: {kind: Float, expr: "max(0, 1 - abs(type_i - 2))"}
  is3: {kind: Float, expr: "max(0, 1 - abs(type_i - 3))"}
  is4: {kind: Float, expr: "max(0, 1 - abs(type_i - 4))"}
  legs_on: {kind: Float, expr: "is0 + is3"}
  r_legshape: {kind: Float, expr: "sin(ts*12.9898+156.466)*43758.5453 - floor(sin(ts*12.9898+156.466)*43758.5453)"}
  r_apron: {kind: Float, expr: "sin(ts*12.9898+234.699)*43758.5453 - floor(sin(ts*12.9898+234.699)*43758.5453)"}
  r_shelf: {kind: Float, expr: "sin(ts*12.9898+312.932)*43758.5453 - floor(sin(ts*12.9898+312.932)*43758.5453)"}
  r_rails: {kind: Float, expr: "sin(ts*12.9898+391.165)*43758.5453 - floor(sin(ts*12.9898+391.165)*43758.5453)"}
  r_lowy: {kind: Float, expr: "sin(ts*12.9898+469.398)*43758.5453 - floor(sin(ts*12.9898+469.398)*43758.5453)"}
  r_foot: {kind: Float, expr: "sin(ts*12.9898+547.631)*43758.5453 - floor(sin(ts*12.9898+547.631)*43758.5453)"}
  r_pedround: {kind: Float, expr: "sin(ts*12.9898+625.864)*43758.5453 - floor(sin(ts*12.9898+625.864)*43758.5453)"}
  r_colsq: {kind: Float, expr: "sin(ts*12.9898+704.097)*43758.5453 - floor(sin(ts*12.9898+704.097)*43758.5453)"}
  r_basesq: {kind: Float, expr: "sin(ts*12.9898+782.33)*43758.5453 - floor(sin(ts*12.9898+782.33)*43758.5453)"}
  r_full: {kind: Float, expr: "sin(ts*12.9898+860.563)*43758.5453 - floor(sin(ts*12.9898+860.563)*43758.5453)"}
  r_side: {kind: Float, expr: "sin(ts*12.9898+938.796)*43758.5453 - floor(sin(ts*12.9898+938.796)*43758.5453)"}
  r_nc: {kind: Float, expr: "sin(ts*12.9898+1017.03)*43758.5453 - floor(sin(ts*12.9898+1017.03)*43758.5453)"}
  r_nr: {kind: Float, expr: "sin(ts*12.9898+1095.26)*43758.5453 - floor(sin(ts*12.9898+1095.26)*43758.5453)"}
  r_hvert: {kind: Float, expr: "sin(ts*12.9898+1173.5)*43758.5453 - floor(sin(ts*12.9898+1173.5)*43758.5453)"}
  r_htop: {kind: Float, expr: "sin(ts*12.9898+1251.73)*43758.5453 - floor(sin(ts*12.9898+1251.73)*43758.5453)"}
  r_w: {kind: Float, expr: "sin(ds*12.9898+1329.96)*43758.5453 - floor(sin(ds*12.9898+1329.96)*43758.5453)"}
  r_d: {kind: Float, expr: "sin(ds*12.9898+1408.19)*43758.5453 - floor(sin(ds*12.9898+1408.19)*43758.5453)"}
  r_h: {kind: Float, expr: "sin(ds*12.9898+1486.43)*43758.5453 - floor(sin(ds*12.9898+1486.43)*43758.5453)"}
  r_topt: {kind: Float, expr: "sin(ds*12.9898+1564.66)*43758.5453 - floor(sin(ds*12.9898+1564.66)*43758.5453)"}
  r_bev: {kind: Float, expr: "sin(ds*12.9898+1642.89)*43758.5453 - floor(sin(ds*12.9898+1642.89)*43758.5453)"}
  W: {kind: Float, expr: "(is0*0.9 + is1*1.4 + is2*0.7 + is3*1.2 + is4*1) + r_w*(is0*1.1 + is1*1 + is2*0.6 + is3*1 + is4*1)"}
  D_raw: {kind: Float, expr: "(is0*0.55 + is1*0.65 + is2*0.7 + is3*0.55 + is4*0.5) + r_d*(is0*0.45 + is1*0.3 + is2*0.6 + is3*0.25 + is4*0.25)"}
  D: {kind: Float, expr: "is2*W + (1-is2)*D_raw"}
  H: {kind: Float, expr: "(is0*0.7 + is1*0.72 + is2*0.7 + is3*0.8 + is4*0.8) + r_h*(is0*0.08 + is1*0.06 + is2*0.06 + is3*0.15 + is4*0.12)"}
  top_t: {kind: Float, expr: "(is0*0.02 + is1*0.03 + is2*0.025 + is3*0.04 + is4*0.03) + r_topt*(is0*0.03 + is1*0.03 + is2*0.025 + is3*0.05 + is4*0.03)"}
  top_y: {kind: Float, expr: "H - top_t/2"}
  leg_h: {kind: Float, expr: "max(0.1, H - top_t)"}
  leg_y: {kind: Float, expr: "leg_h/2"}
  top_r: {kind: Float, expr: "W/2"}
  ped_round: {kind: Float, expr: "floor(r_pedround + 0.65)"}
  top_round: {kind: Float, expr: "is2*ped_round"}
  bevel_eff: {kind: Float, expr: "max(0, bevel*(1 + (r_bev*2 - 1)*bevel_variation))"}
  r_legw: {kind: Float, expr: "sin(ds*12.9898+1721.13)*43758.5453 - floor(sin(ds*12.9898+1721.13)*43758.5453)"}
  r_inset: {kind: Float, expr: "sin(ds*12.9898+1799.36)*43758.5453 - floor(sin(ds*12.9898+1799.36)*43758.5453)"}
  r_apronh: {kind: Float, expr: "sin(ds*12.9898+1877.59)*43758.5453 - floor(sin(ds*12.9898+1877.59)*43758.5453)"}
  r_apront: {kind: Float, expr: "sin(ds*12.9898+1955.83)*43758.5453 - floor(sin(ds*12.9898+1955.83)*43758.5453)"}
  r_railh: {kind: Float, expr: "sin(ds*12.9898+2034.06)*43758.5453 - floor(sin(ds*12.9898+2034.06)*43758.5453)"}
  r_railt: {kind: Float, expr: "sin(ds*12.9898+2112.29)*43758.5453 - floor(sin(ds*12.9898+2112.29)*43758.5453)"}
  r_shelft: {kind: Float, expr: "sin(ds*12.9898+2190.52)*43758.5453 - floor(sin(ds*12.9898+2190.52)*43758.5453)"}
  leg_w: {kind: Float, expr: "(is0*0.035 + is1*0.035 + is2*0.035 + is3*0.07 + is4*0.035) + r_legw*(is0*0.04 + is1*0.04 + is2*0.04 + is3*0.05 + is4*0.04)"}
  leg_r: {kind: Float, expr: "leg_w/2"}
  inset: {kind: Float, expr: "(is0*0.02 + is1*0.02 + is2*0.02 + is3*0.02 + is4*0.02) + r_inset*(is0*0.1 + is1*0.1 + is2*0.1 + is3*0.06 + is4*0.1)"}
  lx: {kind: Float, expr: "max(0.05, W/2 - inset - leg_w/2)"}
  lz: {kind: Float, expr: "max(0.05, D/2 - inset - leg_w/2)"}
  nlx: {kind: Float, expr: "-lx"}
  nlz: {kind: Float, expr: "-lz"}
  len_x: {kind: Float, expr: "max(0.05, 2*lx - leg_w + 0.01)"}
  len_z: {kind: Float, expr: "max(0.05, 2*lz - leg_w + 0.01)"}
  leg_round: {kind: Float, expr: "floor(r_legshape + is0*0.45 + is3*0.15)"}
  apron_on: {kind: Float, expr: "floor(r_apron + is0*0.6 + is3*0.5)"}
  apron_h: {kind: Float, expr: "0.06 + r_apronh*0.05"}
  apron_t: {kind: Float, expr: "0.018 + r_apront*0.012"}
  apron_y: {kind: Float, expr: "H - top_t - apron_h/2"}
  shelf_on: {kind: Float, expr: "floor(r_shelf + is0*0.2 + is3*0.7)"}
  rails_raw: {kind: Float, expr: "floor(r_rails + is0*0.35 + is3*0.3)"}
  rails_on: {kind: Float, expr: "rails_raw*(1-shelf_on)"}
  low_y: {kind: Float, expr: "leg_h*(0.12 + 0.16*r_lowy)"}
  rail_h: {kind: Float, expr: "0.03 + r_railh*0.02"}
  rail_t: {kind: Float, expr: "0.02 + r_railt*0.01"}
  shelf_t: {kind: Float, expr: "0.02 + r_shelft*0.015"}
  r_endt: {kind: Float, expr: "sin(ds*12.9898+2268.76)*43758.5453 - floor(sin(ds*12.9898+2268.76)*43758.5453)"}
  r_endinset: {kind: Float, expr: "sin(ds*12.9898+2346.99)*43758.5453 - floor(sin(ds*12.9898+2346.99)*43758.5453)"}
  r_enddz: {kind: Float, expr: "sin(ds*12.9898+2425.22)*43758.5453 - floor(sin(ds*12.9898+2425.22)*43758.5453)"}
  r_beamh: {kind: Float, expr: "sin(ds*12.9898+2503.46)*43758.5453 - floor(sin(ds*12.9898+2503.46)*43758.5453)"}
  r_beamt: {kind: Float, expr: "sin(ds*12.9898+2581.69)*43758.5453 - floor(sin(ds*12.9898+2581.69)*43758.5453)"}
  r_drop: {kind: Float, expr: "sin(ds*12.9898+2659.92)*43758.5453 - floor(sin(ds*12.9898+2659.92)*43758.5453)"}
  r_footh: {kind: Float, expr: "sin(ds*12.9898+2738.16)*43758.5453 - floor(sin(ds*12.9898+2738.16)*43758.5453)"}
  end_t: {kind: Float, expr: "0.03 + r_endt*0.03"}
  end_inset: {kind: Float, expr: "0.06 + r_endinset*0.19"}
  end_x: {kind: Float, expr: "max(0.1, W/2 - end_inset - end_t/2)"}
  nend_x: {kind: Float, expr: "-end_x"}
  end_dz: {kind: Float, expr: "0.04 + r_enddz*0.1"}
  end_d: {kind: Float, expr: "max(0.2, D - 2*end_dz)"}
  beam_h: {kind: Float, expr: "0.06 + r_beamh*0.08"}
  beam_t: {kind: Float, expr: "0.04 + r_beamt*0.04"}
  beam_len: {kind: Float, expr: "max(0.1, 2*end_x - end_t + 0.01)"}
  beam_y: {kind: Float, expr: "leg_h - beam_h/2 - r_drop*0.3*leg_h"}
  foot_on: {kind: Float, expr: "floor(r_foot + 0.55*is1)"}
  foot_h: {kind: Float, expr: "0.04 + r_footh*0.03"}
  foot_w: {kind: Float, expr: "end_t + 0.06"}
  foot_d: {kind: Float, expr: "min(D - 0.02, end_d + 0.12)"}
  foot_y: {kind: Float, expr: "foot_h/2"}
  r_colr: {kind: Float, expr: "sin(ds*12.9898+2816.39)*43758.5453 - floor(sin(ds*12.9898+2816.39)*43758.5453)"}
  r_baset: {kind: Float, expr: "sin(ds*12.9898+2894.62)*43758.5453 - floor(sin(ds*12.9898+2894.62)*43758.5453)"}
  r_baser: {kind: Float, expr: "sin(ds*12.9898+2972.85)*43758.5453 - floor(sin(ds*12.9898+2972.85)*43758.5453)"}
  col_r: {kind: Float, expr: "0.035 + r_colr*0.05"}
  col_w: {kind: Float, expr: "2*col_r"}
  col_sq: {kind: Float, expr: "floor(r_colsq + 0.35)"}
  base_t: {kind: Float, expr: "0.03 + r_baset*0.04"}
  base_r: {kind: Float, expr: "min(W/2 - 0.02, W*(0.28 + r_baser*0.14))"}
  base_w: {kind: Float, expr: "2*base_r"}
  base_sq: {kind: Float, expr: "floor(r_basesq + 0.3)"}
  col_h: {kind: Float, expr: "max(0.1, H - top_t - base_t)"}
  col_y: {kind: Float, expr: "base_t + col_h/2"}
  base_y: {kind: Float, expr: "base_t/2"}
  r_ovx: {kind: Float, expr: "sin(ds*12.9898+3051.09)*43758.5453 - floor(sin(ds*12.9898+3051.09)*43758.5453)"}
  r_ovz: {kind: Float, expr: "sin(ds*12.9898+3129.32)*43758.5453 - floor(sin(ds*12.9898+3129.32)*43758.5453)"}
  r_frac: {kind: Float, expr: "sin(ds*12.9898+3207.55)*43758.5453 - floor(sin(ds*12.9898+3207.55)*43758.5453)"}
  r_plinth: {kind: Float, expr: "sin(ds*12.9898+3285.79)*43758.5453 - floor(sin(ds*12.9898+3285.79)*43758.5453)"}
  r_plin: {kind: Float, expr: "sin(ds*12.9898+3364.02)*43758.5453 - floor(sin(ds*12.9898+3364.02)*43758.5453)"}
  r_ept: {kind: Float, expr: "sin(ds*12.9898+3442.25)*43758.5453 - floor(sin(ds*12.9898+3442.25)*43758.5453)"}
  r_ft: {kind: Float, expr: "sin(ds*12.9898+3520.49)*43758.5453 - floor(sin(ds*12.9898+3520.49)*43758.5453)"}
  r_hl: {kind: Float, expr: "sin(ds*12.9898+3598.72)*43758.5453 - floor(sin(ds*12.9898+3598.72)*43758.5453)"}
  r_ht: {kind: Float, expr: "sin(ds*12.9898+3676.95)*43758.5453 - floor(sin(ds*12.9898+3676.95)*43758.5453)"}
  r_hd: {kind: Float, expr: "sin(ds*12.9898+3755.18)*43758.5453 - floor(sin(ds*12.9898+3755.18)*43758.5453)"}
  ov_x: {kind: Float, expr: "0 + r_ovx*0.05"}
  ov_z: {kind: Float, expr: "0 + r_ovz*0.04"}
  full: {kind: Float, expr: "floor(r_full + 0.55*is4)"}
  side: {kind: Float, expr: "2*floor(r_side+0.5)-1"}
  frac: {kind: Float, expr: "0.38 + r_frac*0.27"}
  ep_t: {kind: Float, expr: "0.03 + r_ept*0.02"}
  Wc: {kind: Float, expr: "full*(W - 2*ov_x) + (1-full)*min(W*frac, W - 2*ov_x - ep_t - 0.3)"}
  xc: {kind: Float, expr: "(1-full)*side*(W/2 - ov_x - Wc/2)"}
  Dc: {kind: Float, expr: "max(0.2, D - 2*ov_z)"}
  plinth_h: {kind: Float, expr: "0.04 + r_plinth*0.06"}
  plin_in: {kind: Float, expr: "0.015 + r_plin*0.025"}
  ch: {kind: Float, expr: "max(0.2, H - top_t - plinth_h)"}
  cab_y: {kind: Float, expr: "plinth_h + ch/2"}
  plinth_y: {kind: Float, expr: "plinth_h/2"}
  plinth_w: {kind: Float, expr: "max(0.1, Wc - 2*plin_in)"}
  plinth_d: {kind: Float, expr: "max(0.1, Dc - 2*plin_in)"}
  has_ep: {kind: Float, expr: "1-full"}
  ep_x: {kind: Float, expr: "-side*(W/2 - ov_x - ep_t/2)"}
  nc: {kind: Float, expr: "1 + floor(r_nc*min(3, max(1, floor(Wc/0.3))))"}
  nr: {kind: Float, expr: "1 + floor(r_nr*min(4, max(1, floor(ch/0.16))))"}
  cw: {kind: Float, expr: "(Wc - 0.024)/nc"}
  chh: {kind: Float, expr: "(ch - 0.024)/nr"}
  fw: {kind: Float, expr: "max(0.05, cw - 0.006)"}
  fh: {kind: Float, expr: "max(0.05, chh - 0.006)"}
  ft: {kind: Float, expr: "0.016 + r_ft*0.01"}
  fz: {kind: Float, expr: "Dc/2 + ft/2 - 0.003"}
  dx0: {kind: Float, expr: "xc - Wc/2 + 0.012 + (0+0.5)*cw"}
  ac0: {kind: Float, expr: "max(0, min(1, nc - 0))"}
  dx1: {kind: Float, expr: "xc - Wc/2 + 0.012 + (1+0.5)*cw"}
  ac1: {kind: Float, expr: "max(0, min(1, nc - 1))"}
  dx2: {kind: Float, expr: "xc - Wc/2 + 0.012 + (2+0.5)*cw"}
  ac2: {kind: Float, expr: "max(0, min(1, nc - 2))"}
  dy0: {kind: Float, expr: "plinth_h + 0.012 + (0+0.5)*chh"}
  ar0: {kind: Float, expr: "max(0, min(1, nr - 0))"}
  dy1: {kind: Float, expr: "plinth_h + 0.012 + (1+0.5)*chh"}
  ar1: {kind: Float, expr: "max(0, min(1, nr - 1))"}
  dy2: {kind: Float, expr: "plinth_h + 0.012 + (2+0.5)*chh"}
  ar2: {kind: Float, expr: "max(0, min(1, nr - 2))"}
  dy3: {kind: Float, expr: "plinth_h + 0.012 + (3+0.5)*chh"}
  ar3: {kind: Float, expr: "max(0, min(1, nr - 3))"}
  act_0_0: {kind: Float, expr: "ac0*ar0"}
  act_0_1: {kind: Float, expr: "ac0*ar1"}
  act_0_2: {kind: Float, expr: "ac0*ar2"}
  act_0_3: {kind: Float, expr: "ac0*ar3"}
  act_1_0: {kind: Float, expr: "ac1*ar0"}
  act_1_1: {kind: Float, expr: "ac1*ar1"}
  act_1_2: {kind: Float, expr: "ac1*ar2"}
  act_1_3: {kind: Float, expr: "ac1*ar3"}
  act_2_0: {kind: Float, expr: "ac2*ar0"}
  act_2_1: {kind: Float, expr: "ac2*ar1"}
  act_2_2: {kind: Float, expr: "ac2*ar2"}
  act_2_3: {kind: Float, expr: "ac2*ar3"}
  hl: {kind: Float, expr: "0.08 + r_hl*0.1"}
  ht: {kind: Float, expr: "0.01 + r_ht*0.006"}
  hd: {kind: Float, expr: "0.018 + r_hd*0.012"}
  hvert: {kind: Float, expr: "floor(r_hvert + 0.3)"}
  htop: {kind: Float, expr: "floor(r_htop + 0.4)"}
  hl_eff: {kind: Float, expr: "min(hl, min(0.5*fw, 0.6*fh))"}
  hx: {kind: Float, expr: "hl_eff*(1-hvert) + ht*hvert"}
  hy: {kind: Float, expr: "ht*(1-hvert) + hl_eff*hvert"}
  hz: {kind: Float, expr: "ft/2 + hd/2 - 0.002"}
  hoff: {kind: Float, expr: "htop*(1-hvert)*(fh/2 - 0.04)"}
  r_mtop: {kind: Float, expr: "sin(ms*12.9898+3833.42)*43758.5453 - floor(sin(ms*12.9898+3833.42)*43758.5453)"}
  r_mframe: {kind: Float, expr: "sin(ms*12.9898+3911.65)*43758.5453 - floor(sin(ms*12.9898+3911.65)*43758.5453)"}
  r_msame: {kind: Float, expr: "sin(ms*12.9898+3989.88)*43758.5453 - floor(sin(ms*12.9898+3989.88)*43758.5453)"}
  r_macc: {kind: Float, expr: "sin(ms*12.9898+4068.12)*43758.5453 - floor(sin(ms*12.9898+4068.12)*43758.5453)"}
  r_msameacc: {kind: Float, expr: "sin(ms*12.9898+4146.35)*43758.5453 - floor(sin(ms*12.9898+4146.35)*43758.5453)"}
  r_mmetal: {kind: Float, expr: "sin(ms*12.9898+4224.58)*43758.5453 - floor(sin(ms*12.9898+4224.58)*43758.5453)"}
  idx_top: {kind: Float, expr: "floor(r_mtop*10)"}
  idx_frame: {kind: Float, expr: "floor(r_mframe*15)"}
  same_frame: {kind: Float, expr: "floor(r_msame + 0.25)"}
  idx_acc: {kind: Float, expr: "floor(r_macc*15)"}
  same_acc: {kind: Float, expr: "floor(r_msameacc + 0.3)"}
  idx_metal: {kind: Float, expr: "floor(r_mmetal*5)"}
  bv_table_top: {kind: Float, expr: "max(0, min(bevel_eff, 0.4*min(min(W,top_t),D)))"}
  bv_table_top_round: {kind: Float, expr: "max(0, min(bevel_eff, 0.4*min(top_r,top_t)))"}
  bv_leg: {kind: Float, expr: "max(0, min(bevel_eff, 0.4*min(min(leg_w,leg_h),leg_w)))"}
  bv_leg_round: {kind: Float, expr: "max(0, min(bevel_eff, 0.4*min(leg_r,leg_h)))"}
  bv_apron_rail_long: {kind: Float, expr: "max(0, min(bevel_eff, 0.4*min(min(len_x,apron_h),apron_t)))"}
  bv_apron_rail_short: {kind: Float, expr: "max(0, min(bevel_eff, 0.4*min(min(apron_t,apron_h),len_z)))"}
  bv_lower_rail_long: {kind: Float, expr: "max(0, min(bevel_eff, 0.4*min(min(len_x,rail_h),rail_t)))"}
  bv_lower_rail_short: {kind: Float, expr: "max(0, min(bevel_eff, 0.4*min(min(rail_t,rail_h),len_z)))"}
  bv_lower_shelf: {kind: Float, expr: "max(0, min(bevel_eff, 0.4*min(min(len_x,shelf_t),len_z)))"}
  bv_trestle_end: {kind: Float, expr: "max(0, min(bevel_eff, 0.4*min(min(end_t,leg_h),end_d)))"}
  bv_trestle_beam: {kind: Float, expr: "max(0, min(bevel_eff, 0.4*min(min(beam_len,beam_h),beam_t)))"}
  bv_trestle_foot: {kind: Float, expr: "max(0, min(bevel_eff, 0.4*min(min(foot_w,foot_h),foot_d)))"}
  bv_column_round: {kind: Float, expr: "max(0, min(bevel_eff, 0.4*min(col_r,col_h)))"}
  bv_column_square: {kind: Float, expr: "max(0, min(bevel_eff, 0.4*min(min(col_w,col_h),col_w)))"}
  bv_base_round: {kind: Float, expr: "max(0, min(bevel_eff, 0.4*min(base_r,base_t)))"}
  bv_base_square: {kind: Float, expr: "max(0, min(bevel_eff, 0.4*min(min(base_w,base_t),base_w)))"}
  bv_cabinet_body: {kind: Float, expr: "max(0, min(bevel_eff, 0.4*min(min(Wc,ch),Dc)))"}
  bv_cabinet_plinth: {kind: Float, expr: "max(0, min(bevel_eff, 0.4*min(min(plinth_w,plinth_h),plinth_d)))"}
  bv_cabinet_end_panel: {kind: Float, expr: "max(0, min(bevel_eff, 0.4*min(min(ep_t,leg_h),Dc)))"}
  bv_drawer_front: {kind: Float, expr: "max(0, min(bevel_eff, 0.4*min(min(fw,fh),ft)))"}
  bv_drawer_handle: {kind: Float, expr: "max(0, min(bevel_eff, 0.4*min(min(hx,hy),hd)))"}
outputs:
  Geometry:
    node: 354
    pin: Geometry
